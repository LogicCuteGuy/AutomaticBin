{
  "permissions": {
    "allow": [
      "mcp__minimax__web_search",
      "Bash(cargo install *)",
      "Bash(espup install *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.espressif.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(fuser /dev/ttyUSB0)",
      "Bash(dmesg)",
      "Bash(lsusb)",
      "Bash(cargo build *)",
      "Bash(cargo doc *)",
      "Bash(git add *)"
    ]
  }
}
